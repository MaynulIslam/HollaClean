# Stripe API Keys (get these from https://dashboard.stripe.com/apikeys)
# Use TEST keys for development, LIVE keys for production

# Secret key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_live_your_secret_key_here

# Publishable key (starts with pk_test_ or pk_live_)
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here

# Webhook secret — get this AFTER registering your webhook endpoint in Stripe Dashboard:
# Stripe Dashboard → Developers → Webhooks → Add endpoint
# Endpoint URL: https://YOUR-RENDER-URL.onrender.com/api/webhooks/stripe
# Events: payment_intent.succeeded, payment_intent.payment_failed, account.updated
# Then click "Reveal" on the Signing secret → paste below
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Server configuration
PORT=3001
FRONTEND_URL=https://www.hollaclean.com

# Platform settings
PLATFORM_FEE_PERCENT=20

# Admin auth token (used for /api/admin/* routes — must match VITE_ADMIN_SECRET in frontend .env)
ADMIN_SECRET=change-this-to-a-strong-random-secret

# ─── Database (the rebuild) ─────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma. On Render, create a Postgres
# instance and paste its Internal Connection String here.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/hollaclean?schema=public

# Secret used to sign user JWTs. MUST be set in production (the server refuses
# to start otherwise). Generate one with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string

# ─── Google sign-in (server-side token verification) ────────────────────────
# The Firebase service-account JSON, as a SINGLE-LINE stringified value.
# Firebase Console → Project Settings → Service accounts → Generate new private
# key, then JSON.stringify the file contents into one line. Until this is set,
# the /api/auth/google endpoint returns 503 (secure default).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
