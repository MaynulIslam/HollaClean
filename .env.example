# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# EmailJS (https://www.emailjs.com — free tier: 200 emails/month)
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your_public_key

# Stripe publishable key (pk_test_... for dev, pk_live_... for prod)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Backend API URL (no trailing slash)
# Development: http://localhost:3001
# Production: https://your-api-domain.com
VITE_API_URL=http://localhost:3001

# Admin token — must match ADMIN_SECRET in server/.env
VITE_ADMIN_SECRET=change-this-to-a-strong-random-secret
